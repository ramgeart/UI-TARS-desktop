# UI-TARS Agent Environment Variables
# Copy this file to /etc/ui-tars/ui-tars-agent.env and configure

# Required: API Key for your VLM provider
UI_TARS_API_KEY=your-api-key-here

# Optional: Override display (default is :0)
# DISPLAY=:0

# Optional: Override provider (set in config file or here)
# UI_TARS_PROVIDER=openai

# Optional: Override model (set in config file or here)
# UI_TARS_MODEL=gpt-4-vision-preview
